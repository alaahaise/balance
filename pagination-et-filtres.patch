+    expect(escapeLike('a_b')).toBe('a\\_b')
+    expect(escapeLike('a\\b')).toBe('a\\\\b')
+    expect(containsPattern('100%')).toBe('%100\\%%')
+  })
+
+  it('laisse intact un texte ordinaire', () => {
+    expect(containsPattern('CMV X')).toBe('%CMV X%')
